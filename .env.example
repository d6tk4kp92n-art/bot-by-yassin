# =====================================================================
#  Tekkit Watch - fichier de configuration SECRET
#  1) Copie ce fichier et renomme la copie en  .env
#  2) Remplis les lignes ci-dessous (sans espaces autour du =)
#  3) Ne partage JAMAIS le fichier .env (il contient le token du bot)
# =====================================================================

# --- OBLIGATOIRE ------------------------------------------------------

# Token du bot : portail développeur Discord -> ton application -> Bot -> Reset Token
DISCORD_TOKEN=

# Ton ID Discord (clic droit sur ton pseudo -> Copier l'identifiant)
# Seul ce compte peut ouvrir /parametres, utiliser l'OSINT, etc.
OWNER_ID=

# ID du salon où le webhook « Tekkit | Rewards Logger » poste ses messages
# (clic droit sur le salon -> Copier l'identifiant du salon)
WEBHOOK_CHANNEL_ID=

# --- IA LOCALE (gratuite) ---------------------------------------------

# Adresse d'Ollama. Ne change rien si Ollama tourne sur le même PC.
# Avec docker-compose et le profil « ia » : http://ollama:11434
OLLAMA_URL=http://localhost:11434

# --- OPTIONNEL (gratuit) : analyse de liens /osint lien ---------------
# Le bot marche très bien sans. Laisse vide si tu n'en as pas.

# VirusTotal : crée un compte gratuit sur https://www.virustotal.com
# puis clique sur ton avatar -> API key
VIRUSTOTAL_API_KEY=

# urlscan.io : compte gratuit sur https://urlscan.io -> Settings & API -> New API key
URLSCAN_API_KEY=
